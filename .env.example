# Earth Engine: authenticate with `earthengine authenticate` or use a service account.
GOOGLE_APPLICATION_CREDENTIALS=
EE_PROJECT=
# FIRMS MAP_KEY: request one from https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=
# Local default; override with a PostgreSQL SQLAlchemy URL for a PostgreSQL deployment.
DATABASE_URL=sqlite:///data/processed/action_platform.db
# Demo mode is on only for the explicitly synthetic local hackathon story.
DEMO_MODE=true
# Optional read-only product snapshot selection: demo or real.
DATA_MODE=demo
# Set a random value with at least 32 characters when running multiple processes.
# Live mode refuses to start without this value and must not use demo credentials.
JWT_SECRET=
# Exact allowlist, never use a wildcard.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional deployment frontend configuration. Empty values keep the offline map.
VITE_API_BASE_URL=/api/v1
VITE_MAP_TILE_URL=
VITE_MAP_ATTRIBUTION=
